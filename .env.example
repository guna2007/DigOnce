# Local SQLite database. The default is workspaces/core-app/data/onedig.sqlite.
DATABASE_PATH=./data/onedig.sqlite

# Set both values before starting the operator API. Never use these example values in production.
OPERATOR_PASSWORD=
OPERATOR_SECRET=
OPERATOR_LABEL=Demo operator

# Optional server-side notice intake provider settings.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional map tile URL template. The resident list works without tiles.
MAP_TILE_URL=

# The demo records are illustrative and date-relative to this day.
DEMO_DAY=
