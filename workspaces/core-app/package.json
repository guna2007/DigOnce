{
  "name": "@onedig/core-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:e2e": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1 --port 4179 --strictPort\"",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx --test ../../tests/core/*.test.ts",
    "test:integration": "tsx --test ../../tests/integration/*.test.ts",
    "test:e2e": "npm run seed:reset && playwright test",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "seed:reset": "tsx src/server/db/seed.ts --reset"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^8.3.0",
    "@onedig/innovation": "file:../innovation",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.6.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
